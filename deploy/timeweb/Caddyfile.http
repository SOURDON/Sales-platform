# HTTP без домена (только IP): сайт + API на :80
:80 {
	encode gzip

	@api path /health /health* /auth /auth/* /admin /admin/* /director /director/* /dashboard /dashboard/*
	handle @api {
		reverse_proxy api:3000
	}

	@sw path /sw.js
	handle @sw {
		root * /srv/www
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
