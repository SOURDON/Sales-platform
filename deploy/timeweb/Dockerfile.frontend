FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Пустой URL = запросы на тот же домен (https://ваш-сайт.ru)
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM alpine:3.20
COPY --from=build /app/dist /srv/www
VOLUME ["/srv/www"]
CMD ["sleep", "infinity"]
