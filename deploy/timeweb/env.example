# Скопируйте на сервер: cp env.example .env && nano .env

# --- Домен API (для HTTPS, файл Caddyfile.domain). Пример: api.fotografy.ru
API_DOMAIN=api.example.ru
# Email для Let's Encrypt
ACME_EMAIL=admin@example.ru

# --- PostgreSQL (внутри Docker, не открывайте порт наружу)
POSTGRES_USER=sales
POSTGRES_DB=sales_platform
# Сгенерируйте: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- CORS: Vercel (если есть) + origins для Tauri desktop
# Пример:
# CORS_ORIGIN=https://your-app.vercel.app,tauri://localhost,https://tauri.localhost
CORS_ORIGIN=tauri://localhost,https://tauri.localhost

# --- Пароль директора после первого сида (мин. 8 символов). Опционально.
DEMO_DEFAULT_PASSWORD=

# Память Node внутри контейнера API
NODE_OPTIONS=--max-old-space-size=512
