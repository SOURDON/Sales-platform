# Скопируйте на сервер: cp env.example .env && nano .env

# --- Ваш сайт на Timeweb (.ru), один домен для веб-интерфейса и API
# DNS: A-запись @ и (по желанию) www → IP сервера
SITE_DOMAIN=fotografy.ru
# Email для Let's Encrypt (обязательно реальный)
ACME_EMAIL=admin@example.ru
# Устаревшее имя (не используйте): API_DOMAIN=

# --- PostgreSQL (внутри Docker, не открывайте порт наружу)
POSTGRES_USER=sales
POSTGRES_DB=sales_platform
# Сгенерируйте: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- CORS (подставится скриптом enable-site-ru.sh)
CORS_ORIGIN=https://fotografy.ru,tauri://localhost,https://tauri.localhost

# --- Пароль директора после первого сида (мин. 8 символов). Опционально.
DEMO_DEFAULT_PASSWORD=

# Память Node внутри контейнера API
NODE_OPTIONS=--max-old-space-size=768
# Сколько дней продаж держать в RAM (1825 ≈ 5 лет)
SALES_MEMORY_DAYS=1825
